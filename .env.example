# DeepMarket Environment Variables Template
VITE_SUPABASE_PROJECT_ID=bfqrmgmnzmgdzboamjhd
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Razorpay Standard Web Checkout Integration (Optional)
VITE_RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# PayU India Payment Gateway Integration
# Paste the values from your PayU Developer Dashboard (Developers -> API Keys)
PAYU_MERCHANT_KEY=YOUR_PAYU_KEY
PAYU_MERCHANT_SALT=YOUR_PAYU_SALT

# Client ID & Client Secret (Developers -> API Keys -> Client ID & Client secret)
PAYU_CLIENT_ID=YOUR_PAYU_CLIENT_ID
PAYU_CLIENT_SECRET=YOUR_PAYU_CLIENT_SECRET

# PayU Environment: 'test' (sandbox) or 'production' (live)
PAYU_ENV=test
PAYU_SUCCESS_URL=http://localhost:4000/api/payu/response
PAYU_FAILURE_URL=http://localhost:4000/api/payu/response
FRONTEND_URL=http://localhost:3000
